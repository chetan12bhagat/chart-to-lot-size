# Anthropic Claude API Key (Required for AI chart screenshot reading)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Model (Optional, defaults to claude-3-5-sonnet-20241022 or claude-sonnet-5-5)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Optional App Password protection for /api/read-chart
# APP_PASSWORD=your_app_password_here

# Rate limiting: Maximum chart reads per IP per hour (defaults to 20)
MAX_READS_PER_HOUR=20
